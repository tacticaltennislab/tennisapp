generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("customer")
  referredByUserId String?
  createdAt        DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  videoSubmissions  VideoSubmission[]
  messages          Message[]
  purchases         Purchase[]
  pushSubscriptions PushSubscription[]
  reviews           Review[]
  academyMemberships AcademyMember[]
  academyPlayers    AcademyPlayer[]
  creditLedger      CreditLedger[]
  reviewedSubmissions VideoSubmission[] @relation("ReviewedSubmissions")
  referredBy        User?               @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals         User[]              @relation("Referrals")
}

model Academy {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members AcademyMember[]
  players AcademyPlayer[]
  invites AcademyInvite[]

  creditLedger  CreditLedger[]
  subscriptions AcademySubscription[]
}

model AcademyMember {
  id        String   @id @default(cuid())
  academyId String
  userId    String
  role      String   @default("coach")
  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([academyId, userId])
}

model AcademyPlayer {
  id        String   @id @default(cuid())
  academyId String
  userId    String
  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([academyId, userId])
}

model AcademyInvite {
  id         String    @id @default(cuid())
  academyId  String
  email      String
  role       String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  sender    String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Purchase {
  id                   String    @id @default(cuid())
  userId               String
  planName             String
  amount               Int
  currency             String    @default("usd")
  mode                 String
  stripeSessionId      String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  status               String    @default("pending")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditLedger CreditLedger[]
}

model Coach {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  specialty String?
  bio       String?
  gptcaUrl  String?
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id               String    @id @default(cuid())
  userId           String
  rating           Int
  body             String
  mediaUrl         String?
  mediaContentType String?
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model VideoSubmission {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  note        String?
  skillLevel  String?
  goal        String?
  focusAreas  String[] @default([])
  storagePath String
  fileName    String
  fileType    String
  fileSize    Int
  status      String   @default("pending")
  coachNotes  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  // Free match or training analysis (one per account): written by a coach as
  // separate tactical and technical notes. publishConsent is the player's
  // opt-in to show the text, without their name, on the public page;
  // publishedAt is set by an admin when it is actually published.
  isFree         Boolean   @default(false)
  footageType    String?
  tacticalNotes  String?
  technicalNotes String?
  publishConsent Boolean   @default(false)
  publishedAt    DateTime?

  // How the analysis was ordered and checked. status: pending | in_review | reviewed | rejected
  analysisType      String?
  declaredMinutes   Float?
  actualDurationSec Float?
  reviewedById      String?

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                   @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  creditLedger CreditLedger[]
  observations SubmissionObservation[]
  report       SubmissionReport?
}

/// Every change to a credit balance is one row here; a balance is the sum of `delta`.
/// Exactly one of userId and academyId is set (enforced by a CHECK in the migration).
model CreditLedger {
  id                String   @id @default(cuid())
  userId            String?
  academyId         String?
  delta             Int
  /// free_signup | purchase | subscription_renewal | submission | refund | admin_adjustment
  reason            String
  purchaseId        String?
  videoSubmissionId String?
  note              String?
  /// Makes grants idempotent: the same signup, Stripe checkout session or invoice never writes twice.
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  academy         Academy?         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  videoSubmission VideoSubmission? @relation(fields: [videoSubmissionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([academyId])
  @@index([videoSubmissionId])
}

/// An academy's recurring plan. Each paid invoice grants `creditsPerPeriod` to the academy.
model AcademySubscription {
  id                   String    @id @default(cuid())
  academyId            String
  /// A plan id from src/lib/plans.ts, e.g. "academy-starter"
  planKey              String
  /// monthly | quarterly | semiannual
  billingInterval      String
  stripeCustomerId     String?
  stripeSubscriptionId String    @unique
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  creditsPerPeriod     Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId])
}

/// One coach observation on a moment of the video. Visible to the client once the submission is reviewed.
model SubmissionObservation {
  id           String   @id @default(cuid())
  submissionId String
  timeSec      Float
  /// strength | issue | tactical
  kind         String
  title        String
  text         String
  /// Where the coach pointed, in percent of the frame
  pinX         Float?
  pinY         Float?
  /// Annotated frame as a PNG data URL (imported from the local analysis tool)
  drawing      String?
  createdAt    DateTime @default(now())

  submission VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// The written summary of an analysis: what the client reads next to the video.
model SubmissionReport {
  id           String    @id @default(cuid())
  submissionId String    @unique
  strengths    String[]  @default([])
  /// [{ title, detail }]
  issues       Json      @default("[]")
  tactical     String[]  @default([])
  priorities   String[]  @default([])
  /// [{ name, detail }]
  drills       Json      @default("[]")
  /// Match charting statistics imported from the local analysis tool, if any
  charting     Json?
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?

  submission VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
