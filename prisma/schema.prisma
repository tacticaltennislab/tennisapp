generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("customer")
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  videoSubmissions VideoSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Coach {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  specialty String?
  bio       String?
  createdAt DateTime @default(now())
}

model VideoSubmission {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  note        String?
  storagePath String
  fileName    String
  fileType    String
  fileSize    Int
  status      String   @default("pending")
  coachNotes  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
